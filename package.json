{
  "name": "hoard",
  "version": "0.4.0",
  "description": "Shows size on disk, including mods, on the game page for Steam and non-Steam games.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "bash scripts/build-zip.sh"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "storage",
    "mods"
  ],
  "author": "Adam Englund",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@eslint/js": "9",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "8",
    "vitest": "4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
